# znd-weather-system — environment variable template.
# Copy to .env (wrangler reads .env automatically for `wrangler dev` / secret setup).
# NEVER commit .env — values here are PLACEHOLDERS only.

# --- Data source ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
FORECAST_DAYS=7
STALE_AFTER_HOURS=8
MAX_RETRIES_PER_REQUEST=2
REQUEST_TIMEOUT_MS=15000

# --- Publishing (default: OFF; do not enable until credentials are set AND a dry-run succeeds) ---
FACEBOOK_PUBLISH_ENABLED=false
# FACEBOOK_PAGE_ACCESS_TOKEN=REPLACE_WITH_LONG_LIVED_PAGE_TOKEN
# FACEBOOK_PAGE_ID=REPLACE_WITH_PAGE_ID

# --- Admin ---
# Generate with: openssl rand -hex 32
# Set via: wrangler secret put ADMIN_SECRET
# ADMIN_SECRET=replace_with_random_hex
