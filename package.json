    "test:verbose": "node --test --test-reporter=spec test/",
    "fetch:live": "node scripts/fetch-live.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=20"
  },
