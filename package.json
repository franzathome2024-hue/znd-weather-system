{
  "name": "znd-weather-system",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-model weather forecast system for Zamboanga del Norte, Philippines — Cloudflare Workers backend + static frontend.",
  "type": "module",
  "main": "src/worker/index.js",
  "scripts": {
